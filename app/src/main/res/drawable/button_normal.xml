<?xml version="1.0" encoding="utf-8"?>
<!-- Keypad key. A soft drop shadow and a hairline edge instead of the old 0.5dp
     black outline, so a grid of twelve of them does not read as a wire fence. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_dark">
    <item>
        <layer-list>
            <item android:top="1.5dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="@color/shadow_soft" />
                </shape>
            </item>
            <item android:bottom="1.5dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="@color/stone" />
                    <stroke android:width="1dp" android:color="@color/stone_edge" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</ripple>
