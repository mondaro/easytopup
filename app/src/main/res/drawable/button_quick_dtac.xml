<?xml version="1.0" encoding="utf-8"?>
<!-- Quick-dial suggestion. Pale chip so the number stays the loudest thing on
     it; the carrier shows as a bar down the leading edge rather than a fill. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_dark">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <solid android:color="@color/bg_topup_dtac_default" />
                </shape>
            </item>
            <item android:left="4dp">
                <shape android:shape="rectangle">
                    <corners android:topRightRadius="10dp" android:bottomRightRadius="10dp" />
                    <solid android:color="@color/stone" />
                    <stroke android:width="1dp" android:color="@color/stone_edge" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</ripple>
