<?xml version="1.0" encoding="utf-8"?>
<!-- Selected carrier tab. The ground behind it is already this colour, so the
     tab reads as part of the screen and the brass edge is what marks it.
     The bar is drawn by letting a brass layer show through 3dp below the
     carrier layer - inset, not gravity, so it also works on Android 5. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_light">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:topLeftRadius="12dp" android:topRightRadius="12dp" />
                    <solid android:color="@color/brass" />
                </shape>
            </item>
            <item android:bottom="3dp">
                <shape android:shape="rectangle">
                    <corners android:topLeftRadius="12dp" android:topRightRadius="12dp" />
                    <solid android:color="@color/bg_topup_true_default" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
